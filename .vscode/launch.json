{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug auth-service",
      "cargo": {
        "args": [
          "build",
          "--bin",
          "auth-service",
          "--manifest-path",
          "auth-service/Cargo.toml"
        ],
        "filter": {
          "name": "auth-service",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}/auth-service",
      "env": {
        "APP_ADDRESS": "127.0.0.1:3001"
      },
      "envFile": "${workspaceFolder}/auth-service/.env",
      "sourceLanguages": ["rust"]
    }
  ]
}
